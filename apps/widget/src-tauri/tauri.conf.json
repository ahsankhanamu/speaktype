{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri-docs/v2/tooling/cli/schema.json",
  "productName": "SpeakType",
  "version": "0.1.0",
  "identifier": "com.speaktype.widget",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../../apps/widget/webui/dist",
    "beforeDevCommand": "npm run dev --prefix ../../apps/widget/webui",
    "beforeBuildCommand": "npm run build --prefix ../../apps/widget/webui"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "SpeakType",
        "width": 72,
        "height": 88,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:*; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/512x512.png",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/whisper-server"
    ],
    "resources": [],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {}
}
