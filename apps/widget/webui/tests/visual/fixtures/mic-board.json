      { "name": "AirPods Pro", "label": "AirPods Pro (Bluetooth hands-free, 16 kHz)", "is_default": false },
      { "name": "Studio Display Microphone", "label": "Studio Display Microphone (48 kHz)", "is_default": false }
    ],
    "default": "MacBook Pro Microphone"
  },
  "$events": [
    {
      "event": "mic-levels",
      "payload": {
        "levels": [
          { "device": "MacBook Pro Microphone", "level": 0.45 },
          { "device": "AirPods Pro", "level": 0 },
          { "device": "Studio Display Microphone", "level": 0.01 }
        ]
      }
    }
  ]
