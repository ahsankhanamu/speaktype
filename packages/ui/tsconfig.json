{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "types": ["svelte", "vite/client", "node"]
  },
  "include": ["src/**/*", "gallery/**/*", "tests/**/*", "*.ts"]
}
